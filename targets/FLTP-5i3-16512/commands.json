{
    "triggers": ["пожалуйста", "алиса"],
    "commands": {
        "volumeup": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ +{{step}}%",
            "windows": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/volumeup.ps1\" {{step}}",
            "default": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/volumeup.ps1\" {{step}}",
            "step": {
                "linux": 10,
                "windows": 6,
                "default": 6
            }
        },
        "volumedown": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ -{{step}}%",
            "windows": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/volumedown.ps1\" {{step}}",
            "default": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/volumedown.ps1\" {{step}}",
            "step": {
                "linux": 10,
                "windows": 6,
                "default": 6
            }
        },
        "sleepvolume": {
            "level": 1,
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ {{level}}%",
            "windows": "powershell -ExecutionPolicy Bypass -File \"bin/get_volume.ps1\" -Set {{level}}",
            "default": "powershell -ExecutionPolicy Bypass -File \"bin/get_volume.ps1\" -Set {{level}}"
        },
        "sleepfix": {
            "linux": "python -m lib.sleep_event",
            "windows": "python -m lib.sleep_event",
            "default": "python -m lib.sleep_event"
        },
        "playpause": {
            "linux": "playerctl play-pause",
            "windows": "powershell -c \"$s='using System;using System.Runtime.InteropServices;public class K{[DllImport(\\\"user32.dll\\\",CharSet=CharSet.Auto)]public static extern void keybd_event(byte bVk,byte bScan,uint dwFlags,IntPtr dwExtraInfo);public static void k(byte v){keybd_event(v,0,0,IntPtr.Zero);keybd_event(v,0,2,IntPtr.Zero);}}';Add-Type -TypeDefinition $s -ErrorAction Stop;[K]::k(0xB3)\"",
            "default": "powershell -c \"$s='using System;using System.Runtime.InteropServices;public class K{[DllImport(\\\"user32.dll\\\",CharSet=CharSet.Auto)]public static extern void keybd_event(byte bVk,byte bScan,uint dwFlags,IntPtr dwExtraInfo);public static void k(byte v){keybd_event(v,0,0,IntPtr.Zero);keybd_event(v,0,2,IntPtr.Zero);}}';Add-Type -TypeDefinition $s -ErrorAction Stop;[K]::k(0xB3)\""
        },
        "stop": {
            "linux": "playerctl stop",
            "windows": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/mediastop.ps1\"",
            "default": "powershell -ExecutionPolicy Bypass -File \"targets/FLTP-5i3-16512/commands/mediastop.ps1\""
        },
        "openyoutube": {
            "linux": "python -m lib.browser_control youtube-first",
            "windows": "python -m lib.browser_control youtube-first",
            "default": "python -m lib.browser_control youtube-first"
        },
        "youtube_news": {
            "linux": "python -m lib.browser_control youtube-play \"новости\"",
            "windows": "python -m lib.browser_control youtube-play \"новости\"",
            "default": "python -m lib.browser_control youtube-play \"новости\""
        },
        "calendar-reminder": {
            "linux": "python -m lib.reminders \"{{text}}\"",
            "windows": "python -m lib.reminders \"{{text}}\"",
            "default": "python -m lib.reminders \"{{text}}\""
        },
        "task-add": {
            "linux": "python -m lib.tasks create \"{{text}}\"",
            "windows": "python -m lib.tasks create \"{{text}}\"",
            "default": "python -m lib.tasks create \"{{text}}\""
        },
        "calendar-plans": {
            "linux": "python -m lib.plans",
            "windows": "python -m lib.plans",
            "default": "python -m lib.plans",
            "description": "показать текущее или ближайшее событие календаря"
        },
        "task-complete": {
            "linux": "python -m lib.tasks complete \"{{text}}\"",
            "windows": "python -m lib.tasks complete \"{{text}}\"",
            "default": "python -m lib.tasks complete \"{{text}}\"",
            "description": "отметить задачу выполненной"
        },
        "diagnose": {
            "linux": "python -m lib.diagnose launch \"{{text}}\"",
            "windows": "python -m lib.diagnose launch \"{{text}}\"",
            "default": "python -m lib.diagnose launch \"{{text}}\""
        }
    },
    "descriptions": {
        "volumeup": "увеличить громкость",
        "volumedown": "уменьшить громкость",
        "sleepvolume": "ночной режим: опустить громкость до 1%",
        "sleepfix": "ночной режим: перенести начало события «СОН» на сейчас",
        "playpause": "play/pause медиа",
        "stop": "остановить медиа",
        "openyoutube": "открыть YouTube",
        "youtube_news": "искать и играть новости на YouTube",
        "news": "YouTube + новости",
        "calendar-reminder": "напоминание = событие Google Calendar",
        "task-add": "задача в Google Tasks (@default)",
        "diagnose": "анализ последнего лога и чата, автофикс; супервизор WORKING.MD, watchdog 600 секунд, откат git, до 5 попыток; detached, голосовой цикл не блокируется",
        "calendar-plans": "текущее событие из календаря",
        "task-complete": "отметить задачу выполненной",
        "browser-automation": "универсальный браузер (инструмент)",
        "speak-answer": "озвучка результата (сервисный)"
    },
    "requires": {
        "playpause": ["media_session"],
        "stop": ["media_session"],
        "openyoutube": ["vpn"],
        "youtube_news": ["vpn", "browser_youtube"],
        "news": ["vpn"]
    },
    "provides": {
        "openyoutube": ["browser_youtube"],
        "youtube_news": ["browser_youtube"]
    },
    "sequences": {
        "news": {
            "description": "Открыть ютуб и включить новости",
            "steps": ["openyoutube", "youtube_news"]
        },
        "sleepmode": {
            "description": "ночной режим: громкость до 1% + зафиксировать начало события «СОН» в календаре",
            "steps": ["sleepvolume", "sleepfix"]
        }
    },
    "match": {
        "volumeup": ["громче", "сделай громче", "увеличь громкость", "громкость вверх"],
        "volumedown": ["тише", "сделай тише", "уменьши громкость", "громкость вниз"],
        "sleepmode": ["спать", "я спать", "иду спать", "я лег спать", "лег спать", "я пошел спать", "пошел спать", "я ложусь спать", "ложусь спать"],
        "playpause": ["пауза", "плей", "играй", "включи", "дальше"],
        "stop": ["стоп", "остановить", "выключи"],
        "openyoutube": ["открой ютуб", "запусти ютуб", "включи ютуб"],
        "youtube_news": ["новости ютуб", "новости на ютубе"],
        "news": ["включи новости", "покажи новости", "запусти новости"],
        "calendar-reminder": [
            "напомни",
            "напомни мне",
            "напомнишь",
            "напомним",
            "поставь напоминание",
            "создай напоминание",
            "добавь напоминание"
        ],
        "task-add": ["поставь задачу",
            "создай задачу",
            "создай задача",
            "добавь задачу",
            "добавь задача",
            "создать задачу",
            "добавить задачу",
            "запиши задачу",
            "запиши в задачи",
            "добавь в задачи",
            "новая задача"
        ],
        "diagnose": [
            "анализ",
            "диагностика",
            "проверь логи",
            "проверь ошибки",
            "найди ошибки",
            "найди ошибку"
        ]
    },
    "settings": {
        "volumeup": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        },
        "volumedown": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        }
    },
    "llm": {
        "history_limit": 10
    },
    "intent": {
        "enabled": true,
        "include_media": true
    },
    "opencode_cli": {
        "enabled": true,
        "model": "omnirouter/auto/tools"
    }
}
