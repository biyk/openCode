{
    "triggers": [
        "пожалуйста",
        "алиса"
    ],
    "commands": {
        "volumeup": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ +{{step}}%",
            "default": "pactl set-sink-volume @DEFAULT_SINK@ +{{step}}%",
            "step": 10
        },
        "volumedown": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ -{{step}}%",
            "default": "pactl set-sink-volume @DEFAULT_SINK@ -{{step}}%",
            "step": 10
        },
        "playpause": "playerctl play-pause",
        "stop": "playerctl stop"
    },
    "match": {
        "volumeup": [
            "громче",
            "сделай громче",
            "увеличь громкость",
            "громкость вверх"
        ],
        "volumedown": [
            "тише",
            "сделай тише",
            "уменьши громкость",
            "громкость вниз"
        ],
        "playpause": [
            "пауза",
            "плей",
            "играй",
            "включи",
            "стоп",
            "остановить"
        ],
        "stop": [
            "стоп",
            "остановить",
            "выключи"
        ]
    },
    "settings": {
        "volumeup": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        },
        "volumedown": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        }
    },
    "llm": {
        "history_limit": 10
    },
    "intent": {
        "enabled": false,
        "include_media": true
    }
}
