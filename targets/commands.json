{
    "triggers": [
        "пожалуйста",
        "алиса"
    ],
    "commands": {
        "volumeup": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ +{{step}}%",
            "default": "pactl set-sink-volume @DEFAULT_SINK@ +{{step}}%",
            "step": 10
        },
        "volumedown": {
            "linux": "pactl set-sink-volume @DEFAULT_SINK@ -{{step}}%",
            "default": "pactl set-sink-volume @DEFAULT_SINK@ -{{step}}%",
            "step": 10
        },
        "playpause": "playerctl play-pause",
        "stop": "playerctl stop",
        "calendar-reminder": "python -m lib.reminders \"{{text}}\"",
        "task-add": "python -m lib.tasks create \"{{text}}\"",
        "diagnose": "python -m lib.diagnose launch \"{{text}}\""
    },
    "match": {
        "volumeup": [
            "громче",
            "сделай громче",
            "увеличь громкость",
            "громкость вверх"
        ],
        "volumedown": [
            "тише",
            "сделай тише",
            "уменьши громкость",
            "громкость вниз"
        ],
        "playpause": [
            "пауза",
            "плей",
            "играй",
            "включи",
            "стоп",
            "остановить"
        ],
        "stop": [
            "стоп",
            "остановить",
            "выключи"
        ],
        "calendar-reminder": [
            "напомни",
            "напомни мне",
            "напомнишь",
            "напомним",
            "поставь напоминание",
            "создай напоминание",
            "добавь напоминание"
        ],
        "task-add": [
            "создай задачу",
            "создай задача",
            "добавь задачу",
            "добавь задача",
            "создать задачу",
            "добавить задачу",
            "запиши задачу",
            "запиши в задачи",
            "добавь в задачи",
            "новая задача"
        ],
        "diagnose": [
            "анализ",
            "диагностика",
            "проверь логи",
            "проверь ошибки",
            "найди ошибки",
            "найди ошибку"
        ]
    },
    "settings": {
        "volumeup": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        },
        "volumedown": {
            "немного": {"step": 0.5},
            "сильно": {"step": 2.0}
        }
    },
    "llm": {
        "history_limit": 10
    },
    "intent": {
        "enabled": false,
        "include_media": true
    }
}
